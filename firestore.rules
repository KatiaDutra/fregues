rules_version = '2';

// Regras de segurança do Freguês.
// Cole este conteúdo em Firestore Database > Regras, no console do Firebase, e publique.
//
// Três perfis:
//   cliente: qualquer pessoa, sem login. Cria pedidos, consulta o próprio pedido e o próprio cartão
//            e avalia o pedido depois de concluído.
//   cozinha: avança o preparo dos pedidos já liberados, até "pronto". Não mexe em pagamento, entrega nem selos.
//   admin:   confirma pagamentos, marca pedidos não pagos, cancela pedidos, marca a entrega,
//            registra os selos e vê as avaliações.
// Os papéis ficam em equipe/{uid}, num documento criado à mão no console:
//   { "nome": "Cozinha", "papeis": ["cozinha"] }

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Equipe ----------

    function caminhoEquipe() {
      return /databases/$(database)/documents/equipe/$(request.auth.uid);
    }

    function temPapel(papel) {
      return request.auth != null
        && exists(caminhoEquipe())
        && papel in get(caminhoEquipe()).data.papeis;
    }

    function ehCozinha() { return temPapel("cozinha"); }
    function ehAdmin() { return temPapel("admin"); }

    // Cada pessoa da equipe lê só os próprios papéis. Ninguém altera pelo site:
    // os documentos são criados e editados apenas no console do Firebase.
    match /equipe/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ---------- Pedidos ----------

    function pedidoValido(pedido) {
      return pedido.keys().hasOnly(["cliente", "itens", "subtotal", "taxa", "total", "entrega", "pagamento",
          "momentoPagamento", "situacaoPagamento", "troco", "clienteId", "usaPremio", "status", "criadoEm"])
        && pedido.criadoEm == request.time
        && pedido.cliente is string && pedido.cliente.size() > 0 && pedido.cliente.size() <= 80
        && pedido.itens is list && pedido.itens.size() > 0 && pedido.itens.size() <= 30
        && pedido.total is number && pedido.total > 0 && pedido.total < 2000
        && pedido.pagamento is string && pedido.pagamento.size() <= 40
        && (pedido.clienteId == null || (pedido.clienteId is string && pedido.clienteId.size() == 64))
        && pedido.usaPremio is bool
        // Todo pedido nasce com o pagamento pendente.
        // Pago no ato: espera o admin. Pago no recebimento: vai direto para a cozinha.
        && pedido.situacaoPagamento == "pendente"
        && ((pedido.momentoPagamento == "pedido" && pedido.status == "aguardando_pagamento")
          || (pedido.momentoPagamento == "recebimento" && pedido.status == "recebido"));
    }

    // A cozinha só avança o preparo, e só de pedidos já liberados. O trabalho dela termina no "pronto".
    function cozinhaAvanca() {
      let antes = resource.data.status;
      let depois = request.resource.data.status;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "atualizadoEm"])
        && ((antes == "recebido" && depois == "preparando")
          || (antes == "preparando" && depois == "pronto"));
    }

    // O admin marca a entrega (motoboy ou balcão) de um pedido pronto, com a hora da entrega
    function adminEntrega() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "entregueEm", "atualizadoEm"])
        && resource.data.status == "pronto"
        && request.resource.data.status == "finalizado"
        && request.resource.data.entregueEm == request.time;
    }

    // O admin cuida do pagamento. Um pagamento confirmado não pode ser desfeito,
    // porque o selo do cliente já foi registrado junto.
    function adminAtualizaPagamento() {
      let antes = resource.data;
      let depois = request.resource.data;
      return depois.diff(antes).affectedKeys().hasOnly(["situacaoPagamento", "pagamentoAtualizadoEm", "status", "atualizadoEm"])
        && antes.situacaoPagamento != "confirmado"
        && depois.situacaoPagamento in ["confirmado", "nao_pago"]
        && (
          // Pagamento no recebimento: o status do preparo não muda
          (antes.status != "aguardando_pagamento" && antes.status != "cancelado" && depois.status == antes.status)
          // Pago no ato e confirmado: o pedido é liberado para a cozinha
          || (antes.status == "aguardando_pagamento" && depois.status == "recebido" && depois.situacaoPagamento == "confirmado")
          // Pago no ato e não pago: o pedido é cancelado antes de chegar à cozinha
          || (antes.status == "aguardando_pagamento" && depois.status == "cancelado" && depois.situacaoPagamento == "nao_pago")
        );
    }

    match /lojas/{lojaId}/pedidos/{pedidoId} {
      // Qualquer pessoa pode criar um pedido válido
      allow create: if pedidoValido(request.resource.data);

      // O cliente consulta um pedido pelo id (difícil de adivinhar); só a equipe lista todos
      allow get: if true;
      allow list: if ehCozinha() || ehAdmin();

      allow update: if (ehCozinha() && cozinhaAvanca())
        || (ehAdmin() && (adminAtualizaPagamento() || adminEntrega()));

      allow delete: if false;
    }

    // ---------- Avaliações ----------
    // O id da avaliação é o id do pedido. Só se avalia um pedido que existe, foi entregue e está pago,
    // uma única vez (a avaliação não pode ser alterada nem apagada).
    match /lojas/{lojaId}/avaliacoes/{pedidoId} {
      function caminhoPedido() {
        return /databases/$(database)/documents/lojas/$(lojaId)/pedidos/$(pedidoId);
      }

      function avaliacaoValida(avaliacao) {
        let pedido = get(caminhoPedido()).data;
        return pedido.status == "finalizado"
          && pedido.situacaoPagamento == "confirmado"
          && avaliacao.keys().hasOnly(["nota", "comentario", "cliente", "criadoEm"])
          && avaliacao.nota is int && avaliacao.nota >= 1 && avaliacao.nota <= 5
          && (avaliacao.comentario == null || (avaliacao.comentario is string && avaliacao.comentario.size() <= 300))
          && avaliacao.cliente == pedido.cliente
          && avaliacao.criadoEm == request.time;
      }

      allow create: if exists(caminhoPedido()) && avaliacaoValida(request.resource.data);
      allow get: if true;
      allow list: if ehAdmin();
      allow update, delete: if false;
    }

    // ---------- Cartões fidelidade ----------
    // O cliente consulta o próprio cartão pelo id protegido.
    // Só o admin cria e atualiza cartões, ao confirmar um pagamento:
    // assim, nenhum selo é registrado sem o pedido ter sido pago.
    match /lojas/{lojaId}/clientes/{clienteId} {
      allow get: if true;
      allow list: if ehAdmin();
      allow create, update: if ehAdmin();
      allow delete: if false;
    }
  }
}
